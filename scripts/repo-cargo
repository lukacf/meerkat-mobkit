#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && git rev-parse --show-toplevel)"
workspace_root="${repo_root}"
git_common_dir="$(cd "${repo_root}" && git rev-parse --path-format=absolute --git-common-dir)"
worktree_root="$(cd "${repo_root}" && git rev-parse --path-format=absolute --show-toplevel)"

hash_path() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum | cut -c1-10
  else
    printf '%s' "$1" | sha256sum | cut -c1-10
  fi
}

repo_slug="$(basename "${repo_root}")"
repo_key="${repo_slug}-$(hash_path "${git_common_dir}")"

if [[ -n "${RUST_LANE_ID:-}" ]]; then
  lane_key="${RUST_LANE_ID}"
else
  worktree_name="$(basename "${worktree_root}")"
  lane_key="${worktree_name}-$(hash_path "${worktree_root}")"
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
  cache_root="${HOME}/Library/Caches/rust-workspaces"
else
  cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/rust-workspaces"
fi

export CARGO_HOME="${cache_root}/${repo_key}/cargo-home"
export CARGO_TARGET_DIR="${cache_root}/${repo_key}/targets/${lane_key}"

dev_bindings_enabled=false
dev_bindings_config="${MEERKAT_DEV_BINDINGS_CONFIG:-${repo_root}/.dev-bindings/cargo-config.toml}"
if [[ "${MEERKAT_DEV_BINDINGS:-0}" == "1" ]]; then
  dev_bindings_enabled=true
  if [[ ! -f "${dev_bindings_config}" ]]; then
    echo "error: development bindings are enabled but not configured" >&2
    echo "run: scripts/dev-bindings configure --meerkat <path>" >&2
    exit 66
  fi
fi

mkdir -p "${CARGO_HOME}" "${CARGO_TARGET_DIR}"

if [[ "${1-}" == "--print-env" ]]; then
  cat <<EOF
repo_root=${repo_root}
workspace_root=${workspace_root}
repo_key=${repo_key}
lane_key=${lane_key}
CARGO_HOME=${CARGO_HOME}
CARGO_TARGET_DIR=${CARGO_TARGET_DIR}
MEERKAT_DEV_BINDINGS=$([[ "${dev_bindings_enabled}" == "true" ]] && printf 1 || printf 0)
MEERKAT_DEV_BINDINGS_CONFIG=$([[ "${dev_bindings_enabled}" == "true" ]] && printf '%s' "${dev_bindings_config}" || true)
EOF
  exit 0
fi

if [[ "${1-}" == "--doctor" ]]; then
  if [[ "${CARGO_HOME}" == "${repo_root}"* || "${CARGO_TARGET_DIR}" == "${repo_root}"* ]]; then
    echo "error: cache path resolved inside repo tree" >&2
    exit 1
  fi
  [[ -w "${CARGO_HOME}" ]] || { echo "error: CARGO_HOME not writable" >&2; exit 1; }
  [[ -w "${CARGO_TARGET_DIR}" ]] || { echo "error: CARGO_TARGET_DIR not writable" >&2; exit 1; }
  cat <<EOF
doctor=ok
repo_root=${repo_root}
workspace_root=${workspace_root}
repo_key=${repo_key}
lane_key=${lane_key}
CARGO_HOME=${CARGO_HOME}
CARGO_TARGET_DIR=${CARGO_TARGET_DIR}
EOF
  exit 0
fi

cd "${workspace_root}"
if [[ "${dev_bindings_enabled}" == "true" ]]; then
  exec "${repo_root}/scripts/run-cargo-with-dev-bindings" \
    "${workspace_root}" "${dev_bindings_config}" -- cargo "$@"
fi
exec "${repo_root}/scripts/run-cargo-with-dev-bindings" \
  "${workspace_root}" "${dev_bindings_config}" --unbound cargo "$@"
