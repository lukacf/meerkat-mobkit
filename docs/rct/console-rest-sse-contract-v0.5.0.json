{
  "contract_version": "0.5.0",
  "version_pin": "v0.5.0",
  "spec_source": {
    "rct_spec_markdown": ".rct/spec.md",
    "rct_spec_yaml": ".rct/spec.yaml",
    "previous_contract": "docs/rct/console-rest-sse-contract-v0.4.0.json"
  },
  "type_refs": {
    "experience": "TYPE-005",
    "identity_status_row": "TYPE-006",
    "activity_filter_preset": "TYPE-012",
    "console_frame": "TYPE-020",
    "console_timeline_query": "TYPE-021",
    "console_send_request": "TYPE-022",
    "console_timeline_accepted": "TYPE-023",
    "console_interaction_rejected_error": "TYPE-019",
    "console_capabilities": "TYPE-024",
    "console_multipart_upload": "TYPE-025",
    "console_blob_reference": "TYPE-026"
  },
  "breaking_changes": [],
  "surfaces": {
    "rest": {
      "experience": {
        "method": "GET",
        "path": "/console/experience",
        "response": {
          "type_ref": "TYPE-005",
          "required_top_level_fields": [
            "contract_version",
            "runtime_capabilities",
            "base_panel",
            "agent_sidebar",
            "activity_feed",
            "chat_inspector",
            "topology",
            "health_overview",
            "flows",
            "session_history"
          ]
        }
      },
      "modules": {
        "method": "GET",
        "path": "/console/modules",
        "response": {
          "required_top_level_fields": [
            "contract_version",
            "modules"
          ]
        }
      },
      "timeline": {
        "method": "GET",
        "path": "/console/timeline",
        "query_optional_fields": [
          "identity",
          "conversation_id",
          "after",
          "before",
          "mode",
          "limit"
        ],
        "response": {
          "required_top_level_fields": [
            "frames"
          ],
          "optional_top_level_fields": [
            "next_cursor",
            "latest_cursor",
            "exhausted",
            "available"
          ],
          "mode_values": [
            "since",
            "recent"
          ]
        }
      },
      "blob": {
        "method": "GET",
        "path_template": "/blobs/{blob_id}",
        "path_prefix": "/blobs/",
        "response": {
          "type_ref": "TYPE-026",
          "body": "binary_or_redirect",
          "required_path_params": [
            "blob_id"
          ]
        }
      }
    },
    "rpc": {
      "console_rpc_endpoint": {
        "method": "POST",
        "path": "/console/rpc",
        "protocol": "JSON-RPC 2.0"
      },
      "console_multipart_rpc_endpoint": {
        "method": "POST",
        "path": "/console/rpc/multipart",
        "protocol": "multipart JSON-RPC 2.0",
        "request": {
          "type_ref": "TYPE-025",
          "required_parts": [
            "payload"
          ],
          "file_part_prefix": "file:"
        }
      },
      "methods": {
        "mobkit/capabilities": {
          "success": {
            "type_ref": "TYPE-024",
            "required_fields": [
              "methods"
            ],
            "optional_fields": [
              "runtime_capabilities",
              "method_capabilities"
            ]
          }
        },
        "mobkit/console/send": {
          "request": {
            "type_ref": "TYPE-022",
            "required_fields": [
              "identity",
              "content"
            ],
            "optional_fields": [
              "origin",
              "idempotency_key",
              "handling_mode"
            ]
          },
          "success": {
            "type_ref": "TYPE-023"
          },
          "errors": [
            {
              "type_ref": "TYPE-019",
              "codes": [
                -32001,
                -32002,
                -32003,
                -32004,
                -32602,
                -32603
              ]
            }
          ]
        },
        "mobkit/console/query_timeline": {
          "request": {
            "type_ref": "TYPE-021"
          },
          "success": {
            "required_fields": [
              "frames"
            ],
            "optional_fields": [
              "next_cursor",
              "latest_cursor",
              "exhausted",
              "available"
            ],
            "request_optional_fields": [
              "identity",
              "conversation_id",
              "after",
              "before",
              "mode",
              "limit"
            ],
            "mode_values": [
              "since",
              "recent"
            ]
          },
          "errors": [
            {
              "type_ref": "TYPE-019",
              "codes": [
                -32001,
                -32002,
                -32003,
                -32004,
                -32013,
                -32602,
                -32603
              ]
            }
          ]
        },
        "mobkit/blob/upload": {
          "request": {
            "type_ref": "TYPE-025",
            "transport": "multipart",
            "required_fields": [
              "content_type"
            ]
          },
          "success": {
            "type_ref": "TYPE-026",
            "required_fields": [
              "blob_id"
            ],
            "optional_fields": [
              "url",
              "content_type",
              "size"
            ]
          }
        }
      }
    },
    "sse": {
      "timeline": {
        "method": "GET",
        "path": "/console/timeline/stream",
        "events": {
          "type_ref": "TYPE-020"
        },
        "headers": {
          "cursor": "Last-Event-ID"
        },
        "errors": [
          {
            "status": 401,
            "shape": {
              "error": "unauthorized",
              "reason": "console stream requires a valid auth token"
            }
          },
          {
            "status": 409,
            "shape": {
              "error": "replay_unavailable",
              "requested_cursor": "console:1",
              "latest_cursor": "console:99"
            }
          }
        ]
      },
      "activity_feed_keep_alive_event": "keep-alive"
    }
  }
}
