module(
    name = "meerkat_mobkit",
    version = "0.7.4",
)

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "apple_support", version = "1.24.5")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.msvc_toolchain(
    msvc_edition = "Professional",
    msvc_release = "2022",
    msvc_version = "14.42.34433",
    windows_kits_version = "10.0.26100.0",
    windows_kits_release = "10",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
    ],
    versions = ["1.94.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
register_toolchains(
    "//platforms:meerkat_windows_cc_toolchain_impl",
    "@buildbuddy_toolchain//:ubuntu_cc_toolchain",
    "@buildbuddy_toolchain//:ubuntu_cc_toolchain_arm64",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# The meerkat machine-authority crates have a build.rs that emits the authority /
# agent-factory bridge code; that script can't run under crate_universe (it can't
# locate the workspace-generated suffix), so mirror meerkat's own BUILD targets:
# turn the build script off, hardcode the suffix env, and force the internal bridge
# features the script would otherwise enable. (mobkit's Cargo.toml enables the
# `live` feature so meerkat-live is in the lock and crate_universe resolves it.)
crate.annotation(
    crate = "meerkat",
    gen_build_script = "off",
    rustc_env = {"MEERKAT_AGENT_FACTORY_POLICY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_agent_factory_build"},
)
crate.annotation(
    crate = "meerkat-core",
    gen_build_script = "off",
    crate_features = [
        "__meerkat-generated-authority-bridge",
        "__meerkat-facade-agent-factory-build",
    ],
    rustc_env = {
        "MEERKAT_GENERATED_AUTHORITY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_generated_authority_bridge",
        "MEERKAT_AGENT_FACTORY_POLICY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_agent_factory_build",
    },
)
crate.annotation(
    crate = "meerkat-runtime",
    gen_build_script = "off",
    rustc_env = {"MEERKAT_GENERATED_AUTHORITY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_generated_authority_bridge"},
)
crate.annotation(
    crate = "meerkat-live",
    gen_build_script = "off",
    rustc_env = {"MEERKAT_GENERATED_AUTHORITY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_generated_authority_bridge"},
)
crate.annotation(
    crate = "meerkat-mob",
    gen_build_script = "off",
    rustc_env = {"MEERKAT_GENERATED_AUTHORITY_BRIDGE_SYMBOL_SUFFIX": "bazel_private_generated_authority_bridge"},
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "crates")
