module(
    name = "meerkat_mobkit",
    version = "0.7.4",
)

# Versions pinned to match meerkat's MODULE.bazel exactly so external-dep build
# actions are identical -> they hit the shared hosted-BuildBuddy cache instead of
# rebuilding. (Step 2 adds bazel_dep(meerkat) so the meerkat crates themselves
# also become cache hits rather than being rebuilt from crates.io.)
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "apple_support", version = "1.24.5")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

# meerkat as a Bazel module (read-only source at the released tag). The meerkat
# crates with build-time machine-authority codegen build correctly as meerkat's
# own targets — and hit the cache from meerkat's v0.7.3 hosted-BuildBuddy release
# instead of being rebuilt from crates.io.
bazel_dep(name = "meerkat", version = "0.0.0")
git_override(
    module_name = "meerkat",
    remote = "https://github.com/lukacf/meerkat.git",
    tag = "v0.7.3",
)

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.msvc_toolchain(
    msvc_edition = "Professional",
    msvc_release = "2022",
    msvc_version = "14.42.34433",
    windows_kits_version = "10.0.26100.0",
    windows_kits_release = "10",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
    ],
    versions = ["1.94.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
register_toolchains(
    "//platforms:meerkat_windows_cc_toolchain_impl",
    "@buildbuddy_toolchain//:ubuntu_cc_toolchain",
    "@buildbuddy_toolchain//:ubuntu_cc_toolchain_arm64",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# The meerkat machine-authority crates have a build.rs that generates authority/
# agent-factory bridge code which only exists inside meerkat's own workspace build
# (crate_universe builds them standalone from crates.io and they can't locate it).
# Redirect those crates' libs to meerkat's own Bazel targets via the meerkat module
# — correct codegen + features, and cache hits from meerkat's release. (meerkat-live
# is not in mobkit's lock; it comes transitively from @meerkat//meerkat-runtime.)
crate.annotation(
    crate = "meerkat",
    override_target_lib = "@meerkat//meerkat:meerkat",
)
crate.annotation(
    crate = "meerkat-core",
    override_target_lib = "@meerkat//meerkat-core:meerkat_core",
)
crate.annotation(
    crate = "meerkat-runtime",
    override_target_lib = "@meerkat//meerkat-runtime:meerkat_runtime",
)
crate.annotation(
    crate = "meerkat-mob",
    override_target_lib = "@meerkat//meerkat-mob:meerkat_mob",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//meerkat-mobkit:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "crates")
