[Unit]
Description=MobKit MDM target daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/mdm-targetd/mdm-targetd.env
WorkingDirectory=/opt/meerkat-mobkit/examples
ExecStart=/usr/bin/env npx tsx 004-mdm-console-pack/src/targetd.ts --id ${MDM_TARGET_ID} --name ${MDM_TARGET_NAME} --site ${MDM_TARGET_SITE} --platform ${MDM_TARGET_PLATFORM} --transport ${MDM_TARGET_TRANSPORT} --listen ${MDM_TARGET_LISTEN} --advertise-url ${MDM_TARGET_ADVERTISE_URL} --kennel ${MDM_KENNEL_URL} --state-dir ${MDM_TARGET_STATE_DIR} --kennel-auth-token ${MDM_AUTH_TOKEN} --control-auth-token ${MDM_TARGET_AUTH_TOKEN} --allow-shell
Restart=always
RestartSec=5
User=mdm-target
Group=mdm-target

[Install]
WantedBy=multi-user.target
