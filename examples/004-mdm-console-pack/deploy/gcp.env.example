# Copy to .env.gcp and fill locally. Do not commit .env.gcp.
GCP_PROJECT=
GCP_ZONE=
GCP_MACHINE_TYPE=e2-medium
GCP_IMAGE_FAMILY=debian-12
GCP_IMAGE_PROJECT=debian-cloud
GCP_TARGET_PREFIX=mobkit-mdm-target
GCP_SSH_USER=
MDM_TARGET_MODEL=gpt-5.5
MDM_TARGET_PROVIDER=openai
MDM_GCP_FORWARD_ENV="OPENAI_API_KEY ANTHROPIC_API_KEY GOOGLE_API_KEY GEMINI_API_KEY OPENAI_BASE_URL OPENAI_ORG_ID"
