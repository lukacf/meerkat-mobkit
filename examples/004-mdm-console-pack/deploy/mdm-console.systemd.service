[Unit]
Description=MobKit MDM kennel console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/mdm-console/mdm-console.env
WorkingDirectory=/opt/meerkat-mobkit/examples
ExecStart=/usr/bin/env npx tsx 004-mdm-console-pack/run.ts --api-listen ${MDM_API_LISTEN_ADDR} --wait --require-auth --require-tls --auth-token ${MDM_AUTH_TOKEN} --target-auth-token ${MDM_TARGET_AUTH_TOKEN} --tls-cert ${MDM_TLS_CERT_PATH} --tls-key ${MDM_TLS_KEY_PATH}
Restart=always
RestartSec=5
User=mdm-console
Group=mdm-console
StateDirectory=mdm-console
ReadWritePaths=/opt/meerkat-mobkit/examples/004-mdm-console-pack/.state

[Install]
WantedBy=multi-user.target
