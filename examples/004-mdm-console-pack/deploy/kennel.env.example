MDM_API_LISTEN_ADDR=0.0.0.0:5788
MDM_CONSOLE_PUBLIC_URL=https://mdm-console.example.invalid
MDM_REQUIRE_TLS=true
MDM_AUTH_TOKEN=replace-with-kennel-api-token
MDM_TARGET_AUTH_TOKEN=replace-with-target-control-token
MDM_TLS_CERT_PATH=/etc/mdm-console/tls.crt
MDM_TLS_KEY_PATH=/etc/mdm-console/tls.key
MDM_BACKUP_DIR=/var/backups/mdm-console
MOBKIT_RPC_GATEWAY_BIN=/opt/meerkat-mobkit/target/release/rpc_gateway
